{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>SonarSource/renovate-config"
  ],
  "minimumReleaseAge": "5 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "prCreation": "immediate",
  "enabledManagers": [
    "github-actions",
    "gradle",
    "gradle-wrapper",
    "mise"
  ],
  "ignorePaths": [
    "integrationTests/**",
    "property-dump-plugin/**",
    "src/test/projects/**"
  ],
  "packageRules": [
    {
      "description": "Review major dependency upgrades in separate PRs.",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "groupSlug": null
    },
    {
      "description": "Use stable Kotlin Gradle plugin releases; exclude IntelliJ-specific and prerelease builds.",
      "matchPackageNames": ["org.jetbrains.kotlin:kotlin-gradle-plugin"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "description": "Keep Spock on the same Groovy variant used by Gradle's localGroovy().",
      "matchPackageNames": ["org.spockframework:spock-core"],
      "versionCompatibility": "^(?<version>.+)-(?<compatibility>groovy-.+)$"
    },
    {
      "description": [
        "Replace built-in artifact updates with a write-locks command so stale buildSrc/buildscript locks do not block configuration.",
        "Install Java explicitly for custom tasks and constrain it to Java 21, which this build requires.",
        "Run per dependency update to preserve the Java constraint during tool installation."
      ],
      "matchManagers": ["gradle", "gradle-wrapper"],
      "constraints": {
        "java": "21"
      },
      "skipArtifactsUpdate": true,
      "postUpgradeTasks": {
        "commands": [
          "./gradlew --no-daemon --console=plain --write-locks :buildSrc:dependencies dependencies buildEnvironment cyclonedxBom wrapper"
        ],
        "fileFilters": [
          "**/*.lockfile",
          "gradle/wrapper/**",
          "gradlew",
          "gradlew.bat"
        ],
        "executionMode": "update",
        "installTools": {
          "java": {}
        }
      }
    }
  ]
}
